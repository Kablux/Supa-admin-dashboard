# GitHub Environment: production (branch main → admin.kabluxe.com)
# Set with:
#   gh secret set SSH_HOST --env production --repo Kablux/Supa-admin-dashboard
#   gh secret set SSH_USER --env production --repo Kablux/Supa-admin-dashboard
#   gh secret set SSH_PRIVATE_KEY --env production --repo Kablux/Supa-admin-dashboard < deploy-prod.pem
#   gh secret set VITE_API_BASE_URL --env production --repo Kablux/Supa-admin-dashboard
#
# Production droplet SSH:
#   SSH_HOST=64.227.27.114
#   SSH_USER=deploy
#   SSH_PRIVATE_KEY= contents of ~/.ssh/proddroplet

