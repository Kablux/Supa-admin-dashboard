# GitHub Environment: test (branch test → staging-admin.kabluxe.com)
# Set with:
#   gh secret set SSH_HOST --env test --repo Kablux/Supa-admin-dashboard
#   gh secret set SSH_USER --env test --repo Kablux/Supa-admin-dashboard
#   gh secret set SSH_PRIVATE_KEY --env test --repo Kablux/Supa-admin-dashboard < deploy-test.pem
#   gh secret set VITE_API_BASE_URL --env test --repo Kablux/Supa-admin-dashboard
#
# Reuse the same SSH_HOST / SSH_USER / SSH_PRIVATE_KEY as kabluxe_backend_op environment "test".

SSH_HOST=
SSH_USER=
SSH_PRIVATE_KEY=
VITE_API_BASE_URL=https://staging-api.kabluxe.com/api/v1
